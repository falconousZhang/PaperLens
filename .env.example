# PaperLens 环境变量配置模板
# 复制为 .env 后填入实际值，不要提交 .env 到版本控制

# 通用
PAPERLENS_ENV=local
PAPERLENS_DEBUG=true

# 数据库（本地开发使用 Docker Compose 中的 PostgreSQL）
PAPERLENS_DATABASE_URL=postgresql+psycopg2://paperlens:paperlens@localhost:5432/paperlens

# LLM 后端：mock（默认，无需密钥）/ huawei_maas（华为云 MaaS 标准 API V2）
PAPERLENS_LLM_BACKEND=mock
# 以下仅在 PAPERLENS_LLM_BACKEND=huawei_maas 时需要
# base URL 从华为云控制台"调用说明"复制，去掉末尾 /chat/completions
# 不同 Region/服务可能使用 /v1、/v2 或区域域名，项目不替用户选择
# PAPERLENS_LLM_BASE_URL=https://api.modelarts-maas.com/v2
# PAPERLENS_LLM_MODEL=glm-5.2
# PAPERLENS_LLM_API_KEY=
# PAPERLENS_LLM_TIMEOUT_SECONDS=60
# PAPERLENS_LEARNING_LLM_TIMEOUT_SECONDS=180
# PAPERLENS_LLM_MAX_COMPLETION_TOKENS=4096

# Embedding 后端：mock（默认）/ huawei_maas
PAPERLENS_EMBEDDING_PROVIDER=mock
# 以下仅在 PAPERLENS_EMBEDDING_PROVIDER=huawei_maas 时需要
# PAPERLENS_EMBEDDING_BASE_URL=https://api.modelarts-maas.com/v1
# PAPERLENS_EMBEDDING_MODEL=bge-m3
# PAPERLENS_EMBEDDING_API_KEY=
# PAPERLENS_EMBEDDING_TIMEOUT_SECONDS=30
# PAPERLENS_EMBEDDING_BATCH_SIZE=32

# 存储：local（本地文件系统）/ obs（华为云 OBS）
PAPERLENS_STORAGE_BACKEND=local
PAPERLENS_STORAGE_ROOT=./data
# 以下仅在 PAPERLENS_STORAGE_BACKEND=obs 时需要
# PAPERLENS_OBS_ENDPOINT=https://obs.<region>.myhuaweicloud.com
# PAPERLENS_OBS_BUCKET=<your-bucket-name>
# PAPERLENS_OBS_PREFIX=paperlens
# PAPERLENS_OBS_CREDENTIAL_MODE=ECS
# PAPERLENS_OBS_SSE_MODE=OBS
# PAPERLENS_OBS_KMS_KEY_ID=
# PAPERLENS_OBS_TIMEOUT_SECONDS=30
# PAPERLENS_OBS_CA_BUNDLE=
# ENV 凭据模式（仅当不使用 ECS Agency 时）
# PAPERLENS_OBS_CREDENTIAL_MODE=ENV
# PAPERLENS_OBS_ACCESS_KEY_ID=
# PAPERLENS_OBS_SECRET_ACCESS_KEY=
# PAPERLENS_OBS_SECURITY_TOKEN=

# 演示用户 ID（MVP 阶段固定值）
PAPERLENS_DEMO_USER_ID=demo-user

# JWT 认证配置
# 必填；至少 32 字节。请在本地 .env 中填入密码学随机值，禁止提交该值。
# 可生成：python -c "import secrets; print(secrets.token_urlsafe(48))"
PAPERLENS_JWT_SECRET=
# PAPERLENS_JWT_ALGORITHM=HS256
# PAPERLENS_JWT_ISSUER=paperlens
# PAPERLENS_JWT_AUDIENCE=paperlens-api
# PAPERLENS_JWT_ACCESS_TTL_MINUTES=15
# PAPERLENS_JWT_REFRESH_TTL_DAYS=30
# PAPERLENS_JWT_RESET_TTL_MINUTES=15
# 本地 HTTP 开发设为 false；生产 HTTPS 必须设为 true
# PAPERLENS_AUTH_COOKIE_SECURE=true
# PAPERLENS_AUTH_MAX_FAILED_LOGINS=5
# PAPERLENS_AUTH_LOCKOUT_MINUTES=15

# 文件上传限制
PAPERLENS_MAX_PDF_SIZE_MB=50
PAPERLENS_MAX_EXPERIMENT_FILE_SIZE_MB=20
PAPERLENS_MAX_EXPERIMENT_ANALYSIS_NUMERIC_CELLS=5000000
# PAPERLENS_EXPERIMENT_COMPARISON_ABSOLUTE_TOLERANCE=1e-6
# PAPERLENS_EXPERIMENT_COMPARISON_RELATIVE_TOLERANCE=0.01

# PDF 解析配置
PAPERLENS_MAX_PAGE_COUNT=500
PAPERLENS_LEARNING_MAX_SOURCE_CHARS=40000
PAPERLENS_LEARNING_MAX_EVIDENCES=12
PAPERLENS_LEARNING_MAX_EVIDENCE_CHARS=2000
PAPERLENS_QA_EVIDENCE_TOP_K=8
PAPERLENS_QA_QUESTION_MAX_CHARS=2000
PAPERLENS_QA_CONTEXT_TURNS=6
PAPERLENS_QA_CONTEXT_MAX_CHARS=12000
PAPERLENS_QA_EVIDENCE_MAX_CHARS=2000
PAPERLENS_CHUNK_MAX_CHARS=1500
PAPERLENS_CHUNK_OVERLAP_CHARS=200
