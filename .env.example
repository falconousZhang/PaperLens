# PaperLens 环境变量配置模板
# 复制为 .env 后填入实际值，不要提交 .env 到版本控制

# 通用
PAPERLENS_ENV=local
PAPERLENS_DEBUG=true

# 数据库（本地开发使用 Docker Compose 中的 PostgreSQL）
PAPERLENS_DATABASE_URL=postgresql+psycopg2://paperlens:paperlens@localhost:5432/paperlens

# LLM 后端：mock（默认，无需密钥）/ maas（华为云 MaaS）
PAPERLENS_LLM_BACKEND=mock

# 存储：local（本地文件系统）/ obs（华为云 OBS，暂未实现）
PAPERLENS_STORAGE_BACKEND=local
PAPERLENS_STORAGE_ROOT=./data

# 演示用户 ID（MVP 阶段固定值）
PAPERLENS_DEMO_USER_ID=demo-user

# 文件上传限制
PAPERLENS_MAX_PDF_SIZE_MB=50
PAPERLENS_MAX_EXPERIMENT_FILE_SIZE_MB=20

# PDF 解析配置
PAPERLENS_MAX_PAGE_COUNT=500
PAPERLENS_CHUNK_MAX_CHARS=1500
PAPERLENS_CHUNK_OVERLAP_CHARS=200
