# 非敏感生产配置模板。密钥和数据库 DSN 必须通过 /run/secrets 文件注入。
PAPERLENS_ENV=production
PAPERLENS_DEBUG=false

PAPERLENS_BACKEND_IMAGE=swr.cn-southwest-2.myhuaweicloud.com/<organization>/paperlens-backend:<version>
PAPERLENS_FRONTEND_IMAGE=swr.cn-southwest-2.myhuaweicloud.com/<organization>/paperlens-frontend:<version>
PAPERLENS_FRONTEND_BIND_ADDRESS=<ecs-private-ip>
PAPERLENS_FRONTEND_PORT=8080

PAPERLENS_AUTH_COOKIE_SECURE=true

PAPERLENS_STORAGE_BACKEND=obs
PAPERLENS_OBS_ENDPOINT=https://obs.cn-southwest-2.myhuaweicloud.com
PAPERLENS_OBS_BUCKET=<private-bucket-name>
PAPERLENS_OBS_PREFIX=paperlens
PAPERLENS_OBS_CREDENTIAL_MODE=ECS
PAPERLENS_OBS_SSE_MODE=OBS
PAPERLENS_OBS_TIMEOUT_SECONDS=30
# 若系统 CA 不包含所需链，挂载 CA 后设置 PAPERLENS_OBS_CA_BUNDLE=/run/secrets/obs_ca.pem
# 使用 SSE-KMS 时设置 PAPERLENS_OBS_SSE_MODE=KMS 与 PAPERLENS_OBS_KMS_KEY_ID=<kms-key-id>

PAPERLENS_LLM_BACKEND=huawei_maas
PAPERLENS_LLM_BASE_URL=https://api.modelarts-maas.com/v2
PAPERLENS_LLM_MODEL=glm-5.2

PAPERLENS_EMBEDDING_PROVIDER=huawei_maas
PAPERLENS_EMBEDDING_BASE_URL=https://api.modelarts-maas.com/v1
PAPERLENS_EMBEDDING_MODEL=bge-m3

# 必须同时信任固定的 Docker 私网和实际 ELB 私网网段；不要填写 0.0.0.0/0。
PAPERLENS_TRUSTED_PROXY_CIDRS=172.30.0.0/24,<elb-private-cidr>

PAPERLENS_DB_POOL_SIZE=10
PAPERLENS_DB_POOL_MAX_OVERFLOW=20
PAPERLENS_DB_POOL_TIMEOUT_SECONDS=10
PAPERLENS_DB_POOL_RECYCLE_SECONDS=1800

PAPERLENS_RECOVERY_ENABLED=true
PAPERLENS_RECOVERY_STALE_SECONDS=300
PAPERLENS_RECOVERY_BATCH_SIZE=50
PAPERLENS_RECOVERY_MAX_WORKERS=4
